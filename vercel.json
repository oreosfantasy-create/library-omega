{
  "version": 2,
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/manus-storage/(.*)", "destination": "/api/index.ts" },
    { "source": "/((?!api|assets|manus-storage|favicon.ico|robots.txt).*)", "destination": "/index.html" }
  ]
}
